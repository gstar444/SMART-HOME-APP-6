rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read/write only their own document in /users/{uid}/...
    match /users/{uid}/documents/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Settings document per user
    match /users/{uid}/app/settings {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ESP32 device pairing records per user
    match /users/{uid}/esp32_devices/{deviceId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // A user can only pair devices they own (server-enforced in app logic too).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.ownerUid == uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
